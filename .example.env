# Telegram
BOT_TOKEN=
# Comma-separated Telegram user IDs. Empty means the bot answers everyone.
ALLOWED_USERS=
# Shared secret the bot process uses to call the API. Any 32+ random chars.
SERVICE_TOKEN=
# Point at a fake Bot API server in tests. Empty in production.
TELEGRAM_API_URL=

# OpenAI, used by the resolver's low-confidence fallback and voice transcription
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Storage
DATABASE_URL=postgres://calbot:calbot@localhost:5432/calbot?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# HTTP
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080

# Runtime
LOG_LEVEL=info
ENV=development
TZ=Europe/Kyiv

# Ingestion
INGEST_USER_AGENT=calbot/1.0 (+https://github.com/arvlas/calbot)
SILPO_BRANCH_ID=00000000-0000-0000-0000-000000000000
OFF_DUMP_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
