# OpenAI, used by the resolver's low-confidence fallback and voice transcription
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Storage. POSTGRES_PASSWORD is the superuser; CALBOT_DB_PASSWORD is the
# application role deploy/postgres/init.sql creates, and must match DATABASE_URL.
POSTGRES_PASSWORD=
CALBOT_DB_PASSWORD=
DATABASE_URL=postgres://calbot:calbot@localhost:5432/calbot?sslmode=disable

# HTTP
HTTP_ADDR=:8080
PUBLIC_URL=http://localhost:8080
# The address Caddy serves on. A bare hostname makes Caddy fetch a certificate.
SITE_ADDRESS=http://localhost

# Runtime
LOG_LEVEL=info
ENV=development
TZ=Europe/Kyiv

# Ingestion
INGEST_USER_AGENT=calbot/1.0 (+https://github.com/arvlas/calbot)
SILPO_BRANCH_ID=00000000-0000-0000-0000-000000000000
OFF_DUMP_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
# Comma-separated Zakaz.ua store IDs to crawl (GET https://stores-api.zakaz.ua/stores/ lists them)
ZAKAZ_STORE_IDS=482010105
# DEMO_KEY allows a few dozen requests an hour; a registered key lifts that
USDA_API_KEY=DEMO_KEY
# Comma-separated generic food queries sent to USDA FoodData Central
USDA_QUERIES=chicken breast,beef,pork,egg,milk,cheese,butter,rice,buckwheat,oats,pasta,bread,potato,tomato,cucumber,carrot,cabbage,onion,apple,banana,orange,salmon,tuna,lentils,sunflower oil,olive oil,sugar,honey
PROE_BASE_URL=https://proe.info
